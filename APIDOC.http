#=================Trainer=======================
#api call for retrieving trainer details
###
GET http://127.0.0.1:8000/trainer/2/
Accept: application/json

#api call for updating trainer details
###
PUT http://127.0.0.1:8000/trainer/2/
Content-Type: application/json

{
    
  "id": 2,
  "qualification": "B.Tech",
  "specialization": "Computer Science",
  "experience": 1,
  "bio":"Passionate in Teaching for last 1 years",
  "designation": "python trainer",
  "user": 2

}
#api call for deleting trainer
###
DELETE http://127.0.0.1:8000/trainer/1/
Accept: application/json

